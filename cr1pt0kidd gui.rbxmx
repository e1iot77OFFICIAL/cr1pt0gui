			<Properties>
				<ProtectedString name="Source"><![CDATA[_G.currentPage = 1

local container = script.Parent
for _, child in pairs(container:GetChildren()) do
	if child.Name:match("^Page%d+$") then
		child.Visible = false
	end
end
local page1 = container:FindFirstChild("Page1")
if page1 then
	page1.Visible = true
end]]></ProtectedString>
