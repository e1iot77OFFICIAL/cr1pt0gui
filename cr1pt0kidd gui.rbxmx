				<Item class="LocalScript" referent="RBX322300105A6F45E7A7047ECA5C6A8531">
					<Properties>
						<ProtectedString name="Source"><![CDATA[script.Parent.MouseButton1Click:Connect(function()
	local container = script.Parent.Parent

	if _G.currentPage == nil then
		_G.currentPage = 1
	end

	if _G.currentPage > 1 then
		_G.currentPage = _G.currentPage - 1
	else
		return
	end

	for _, child in pairs(container:GetChildren()) do
		if child.Name:match("^Page%d+$") then
			child.Visible = false
		end
	end

	local pageName = "Page" .. _G.currentPage
	local page = container:FindFirstChild(pageName)
	if page then
		page.Visible = true
		script.Parent.Parent.PageNum.Text = "Page ".._G.currentPage
	end
end)]]></ProtectedString>
