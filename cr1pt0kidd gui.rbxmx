								<ProtectedString name="Source"><![CDATA[local function music()
script.Parent.MouseButton1Click:Connect(function()
	local m = Instance.new("Sound")
	m.Name = "cr1pt0kiddtheme"
	m.Parent = game.Workspace
	local soundID = script.Parent.Parent.Parent.Parent.Frame2.SoundID.Text
	m.SoundId = "rbxassetid://"..soundID
	m.Volume = 1
	m.Looped = false
	m:Play()
end)
end
music()]]></ProtectedString>
